{
  "name": "bridge-tutor",
  "version": "1.1.0",
  "private": true,
  "description": "Contract bridge against bots, with a tutor that explains every bid and card and a training loop built on your own mistakes.",
  "keywords": [
    "bridge",
    "contract-bridge",
    "card-game",
    "tutor",
    "double-dummy",
    "education"
  ],
  "homepage": "https://bridge-tutor.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otsirh/bridge-tutor.git"
  },
  "bugs": {
    "url": "https://github.com/otsirh/bridge-tutor/issues"
  },
  "license": "MIT",
  "author": "Hristo Ivanov",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.0.5"
  }
}
